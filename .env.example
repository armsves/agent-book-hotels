# Masumi Payment Service. Preprod is a node you run yourself.
# Managed mainnet host: https://payment.masumi.network/api/v1
# Do not set NETWORK=Mainnet until you intend to spend real ADA.
NETWORK=Preprod
PAYMENT_SERVICE_URL=http://localhost:3001/api/v1
PAYMENT_API_KEY=
SELLER_VKEY=
AGENT_IDENTIFIER=

# Public URL of this agent. Registry health checks call it.
AGENT_API_BASE_URL=http://localhost:8080
AGENT_AUTHOR_NAME=Expert Travel Advisor
AGENT_AUTHOR_EMAIL=
AGENT_AUTHOR_ORGANIZATION=Expert Travel Advisor
AGENT_EXAMPLE_OUTPUT_URL=
AGENT_TERMS_URL=
AGENT_PRIVACY_URL=

# Registry discovery (read). Separate key from the payment node.
REGISTRY_SERVICE_URL=https://registry.masumi.network/api/v1
REGISTRY_API_KEY=

# Hotels.com session. Cookie file stays in .secrets/ and is not committed.
# On Vercel, a Browserbase session gives the traveler a sign-in link. Sokosumi shows the link.
# Create the key at https://www.browserbase.com/settings
HOTELS_COOKIE_FILE=.secrets/hotels-cookies.txt
HOTELS_COOKIE=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# AgentMail inbox that receives the Hotels.com one-time sign-in code.
# Create the key at https://console.agentmail.to and keep it in .env only.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=armsves@agentmail.to
HOTELS_DUAID=58349ba0-30e4-4275-a3bf-118074746312
AGENT_PORT=8080
